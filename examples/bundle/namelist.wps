&share
 wrf_core             = 'ARW',
 max_dom              = 2,
 start_date           = '2026-01-01_00:00:00', '2026-01-01_00:00:00',
 end_date             = '2026-01-02_00:00:00', '2026-01-02_00:00:00',
 interval_seconds     = 10800,
 io_form_geogrid      = 2,
/

&geogrid
 parent_id            = 1,   1,
 parent_grid_ratio    = 1,   3,
 i_parent_start       = 1,   34,
 j_parent_start       = 1,   34,
 e_we                 = 100, 100,
 e_sn                 = 100, 100,
 geog_data_res        = 'default', 'default',
 dx                   = 9000,
 dy                   = 9000,
 map_proj             = 'lambert',
 ref_lat              = 37.80,
 ref_lon              = -122.40,
 truelat1             = 30.0,
 truelat2             = 60.0,
 stand_lon            = -122.40,
 geog_data_path       = '/geog',
 opt_geogrid_tbl_path = './',
/

&ungrib
 out_format           = 'WPS',
 prefix               = 'UNGRIB',
/

&metgrid
 fg_name              = 'UNGRIB',
 constants_name       = 'TAVGSFC',
 io_form_metgrid      = 2,
 opt_metgrid_tbl_path = './',
/
